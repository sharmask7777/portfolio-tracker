#!/usr/bin/env bash
. "$(dirname -- "$0")/_/husky.sh"

set -e

echo "Running Rust backend workspace tests..."
(cd backend-rs && cargo test --workspace)

echo "Running Rust parity validation harness..."
(cd backend-rs && cargo run --package portfolio-parity)

echo "Running Rust clippy and formatting checks..."
(cd backend-rs && cargo clippy --workspace --all-targets -- -D warnings && cargo fmt --check)

echo "Running frontend hermetic unit tests..."
(cd frontend && npm run test:unit)

echo "🐳 Starting Docker compose stack for tests..."
export NODE_ENV=development
npm run docker:up

# Ensure we always tear down the stack, even if the tests fail
cleanup() {
  echo "🧹 Tearing down Docker stack..."
  npm run docker:down
}
trap cleanup EXIT

echo "⏳ Waiting for services to become ready (10s)..."
sleep 10

echo "⏳ Running Playwright E2E tests against Docker stack..."
npm run test:e2e:docker --prefix frontend
