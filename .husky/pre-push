#!/usr/bin/env bash

set -e

if [ -d "/Library/Developer/CommandLineTools" ]; then
  export DEVELOPER_DIR="/Library/Developer/CommandLineTools"
  export SDKROOT="/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk"
  export PATH="/Library/Developer/CommandLineTools/usr/bin:${PATH}"
fi

echo "Running static privacy & Anti-PII guardrail..."
python3 scripts/check-privacy-and-pii.py

echo "Running static View Layer Boundary & Zero Business Logic guardrail..."
python3 scripts/check-view-layer-boundaries.py --self-test
python3 scripts/check-view-layer-boundaries.py

echo "Running Rust backend verification pipeline..."
(cd backend-rs && ./scripts/verify.sh)

echo "Verifying TypeScript contracts parity..."
(cd backend-rs && cargo test --package portfolio-api --test export_bindings)
git diff --exit-code frontend/src/types/generated mobile/src/types/generated || (echo "❌ Frontend or mobile types drift detected! Commit updated generated types." && exit 1)

echo "Enforcing backend test coverage thresholds (portfolio-core >= 93%, workspace >= 78%)..."
(cd backend-rs && cargo llvm-cov --package portfolio-core --fail-under-lines 93 --summary-only && cargo llvm-cov --workspace --ignore-filename-regex "(main\.rs|test_mocks\.rs|repositories/)" --fail-under-lines 78 --json --output-path coverage.json)

echo "Verifying mobile build, lints, knip, and coverage (lines 89%, statements 87%, funcs 86%, branches 75%)..."
pnpm --filter mobile build:verify

echo "Running mobile E2E simulation suites..."
pnpm --filter mobile test:e2e

echo "Verifying cross-platform web-mobile domain parity..."
pnpm parity:check

echo "Verifying cross-platform visual parity & invariants..."
pnpm parity:visual

echo "Running frontend hermetic unit tests with coverage gate (lines 89%, statements 87%, funcs 86%, branches 72%)..."
pnpm --filter frontend test:unit

echo "Enforcing incremental diff coverage guardrail (>= 85% of changed lines covered)..."
python3 scripts/check-diff-coverage.py --self-test
python3 scripts/check-diff-coverage.py --min-diff-coverage 85 --backend-cov backend-rs/coverage.json
rm -f backend-rs/coverage.json

echo "Building frontend distribution..."
pnpm --filter frontend build

echo "🐳 Starting Docker compose stack for tests..."
export NODE_ENV=development
pnpm run docker:up

# Ensure we always tear down the stack, even if the tests fail
cleanup() {
  echo "🧹 Tearing down Docker stack..."
  pnpm run docker:down
}
trap cleanup EXIT

echo "⏳ Waiting for backend API to be healthy..."
timeout=75
while ! curl -s -f http://127.0.0.1:8082/api/health > /dev/null 2>&1; do
  sleep 1
  timeout=$((timeout - 1))
  if [ $timeout -le 0 ]; then
    echo "❌ Backend failed to become healthy within 75s"
    docker compose -f docker-compose.yml logs backend
    exit 1
  fi
done
echo "✅ Backend API is ready."

echo "⏳ Running Playwright E2E tests against Docker stack..."
pnpm --filter frontend test:e2e:docker
