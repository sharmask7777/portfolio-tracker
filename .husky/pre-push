#!/usr/bin/env bash
. "$(dirname -- "$0")/_/husky.sh"

set -e

echo "Running Rust backend verification pipeline..."
(cd backend-rs && ./scripts/verify.sh)

echo "Verifying TypeScript contracts parity..."
(cd backend-rs && cargo test --package portfolio-api --test export_bindings)
git diff --exit-code frontend/src/types/generated || (echo "❌ Frontend types drift detected! Commit updated generated types." && exit 1)

echo "Enforcing backend test coverage threshold (fail-under-lines 80%)..."
(cd backend-rs && cargo llvm-cov --workspace --ignore-filename-regex "(main\.rs|test_mocks\.rs|repositories/)" --fail-under-lines 80 --summary-only)

echo "Running frontend hermetic unit tests with coverage gate (lines 88%, statements 86%, funcs 85%, branches 65%)..."
(cd frontend && npm run test:unit)

echo "Building frontend distribution..."
(cd frontend && npm run build)

echo "🐳 Starting Docker compose stack for tests..."
export NODE_ENV=development
npm run docker:up

# Ensure we always tear down the stack, even if the tests fail
cleanup() {
  echo "🧹 Tearing down Docker stack..."
  npm run docker:down
}
trap cleanup EXIT

echo "⏳ Waiting for backend API to be healthy..."
timeout=45
while ! curl -s -f http://127.0.0.1:8082/api/health > /dev/null 2>&1; do
  sleep 1
  timeout=$((timeout - 1))
  if [ $timeout -le 0 ]; then
    echo "❌ Backend failed to become healthy within 45s"
    docker compose -f docker-compose.yml logs backend
    exit 1
  fi
done
echo "✅ Backend API is ready."

echo "⏳ Running Playwright E2E tests against Docker stack..."
npm run test:e2e:docker --prefix frontend
