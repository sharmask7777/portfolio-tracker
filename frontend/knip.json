{
  "$schema": "https://unpkg.com/knip@5/overview/configuration-schema.json",
  "entry": [
    "src/main.tsx!",
    "src/test/setup.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}!"
  ],
  "ignore": [
    "src/types/generated/**",
    "src/components/Family/FamilyManager.tsx",
    "src/utils/consolidation.ts",
    "src/utils/consolidation-types.ts",
    "src/utils/sorting.ts"
  ],
  "ignoreDependencies": [
    "@vitest/ui",
    "@testing-library/jest-dom",
    "@axe-core/playwright"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "src/utils/sorting.ts": ["exports", "types"],
    "src/utils/consolidation.ts": ["exports", "types"],
    "src/utils/hierarchy-builder.ts": ["exports", "types"],
    "src/utils/itr-report-generator.ts": ["exports", "types"],
    "src/components/Analytics/XRayDashboard.tsx": ["exports", "types"]
  }
}
