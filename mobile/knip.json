{
  "$schema": "https://unpkg.com/knip@5/overview/configuration-schema.json",
  "entry": [
    "app/**/*.{ts,tsx}!",
    "src/env.ts!"
  ],
  "project": [
    "app/**/*.{ts,tsx}!",
    "src/**/*.{ts,tsx}!"
  ],
  "ignore": [
    "src/types/generated/**",
    "src/e2e/**"
  ],
  "ignoreDependencies": [
    "expo-updates",
    "expo-system-ui",
    "expo-sqlite",
    "expo-secure-store",
    "expo-local-authentication",
    "expo-camera",
    "expo-document-picker",
    "expo-linking",
    "expo-constants",
    "lucide-react-native",
    "react-native-svg",
    "react-native-safe-area-context",
    "react-native-screens",
    "vitest"
  ],
  "ignoreIssues": {
    "src/components/HoldingCard.tsx": ["exports", "types"],
    "src/components/Family/FamilyMetricsSummary.tsx": ["exports", "types"],
    "src/components/Family/ProfileSwitcher.tsx": ["exports", "types"],
    "src/db/client.ts": ["exports"],
    "src/db/repository.ts": ["exports", "types"],
    "src/db/upload-repository.ts": ["exports"],
    "src/feeds/types.ts": ["types"],
    "src/services/goals-service.ts": ["types"],
    "src/services/hierarchy-builder.ts": ["exports", "types"],
    "src/services/portfolio-calculations.ts": ["exports"],
    "src/services/portfolio-service.ts": ["exports"],
    "src/services/settings-service.ts": ["exports"],
    "src/services/tax-harvesting.ts": ["exports", "types"]
  },
  "ignoreExportsUsedInFile": true
}
