{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "type": "module",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "knip": "knip --production",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --coverage",
    "build:verify": "pnpm lint && pnpm typecheck && pnpm knip && pnpm test:coverage",
    "build:apk": "bash scripts/build-local-apk.sh",
    "build:ios": "bash scripts/build-local-ios.sh",
    "eas:update": "npx eas-cli update --auto",
    "eas:build:android": "npx eas-cli build --platform android --profile preview",
    "eas:build:ios": "npx eas-cli build --platform ios --profile preview",
    "eas:build:all": "npx eas-cli build --platform all --profile preview",
    "test:e2e:maestro:ios": "maestro test e2e/flows/ --platform ios",
    "test:e2e:maestro:android": "maestro test e2e/flows/ --platform android",
    "test:e2e": "vitest run src/e2e"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.0",
    "expo": "~58.0.26",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-document-picker": "~58.0.5",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "^58.0.7",
    "expo-updates": "~58.0.22",
    "lucide-react-native": "^1.75.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "^15.16.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "~19.3.0",
    "eslint": "^10.3.0",
    "eslint-plugin-boundaries": "^7.4.0",
    "eslint-plugin-jsdoc": "^65.4.12",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "knip": "^6.44.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.6"
  }
}
